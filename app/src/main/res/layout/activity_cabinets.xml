<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cabinets">
    <androidx.gridlayout.widget.GridLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.100000024">

        <TextView
            android:id="@+id/textViewCabinets"
            android:layout_width="109dp"
            android:layout_height="30dp"
            android:text="Кабинеты"
            app:layout_column="0"
            app:layout_row="0" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_column="0"
            app:layout_row="1">

            <ImageButton
                android:id="@+id/AddPostButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="AddCabinet"
                android:onClick="clickButtonAddCabinet"
                app:layout_column="0"
                app:layout_row="0"
                app:srcCompat="@android:drawable/ic_menu_add" />

            <ImageButton
                android:id="@+id/UpdateCabinetsListButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="UpdateCabinetsList"
                app:layout_column="1"
                app:layout_row="0"
                app:srcCompat="@android:drawable/stat_notify_sync_noanim" />

            <ImageButton
                android:id="@+id/deleteStaffButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="clickButtonDeleteCabinet"
                android:src="@android:drawable/ic_menu_delete"
                app:layout_column="2"
                app:layout_row="0" />


            <ListView
                android:id="@+id/CabinetsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="multipleChoice"
                app:layout_column="0"
                app:layout_columnSpan="3"
                app:layout_row="2" />

        </androidx.gridlayout.widget.GridLayout>
    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>