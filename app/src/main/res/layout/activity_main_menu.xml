<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.gridlayout.widget.GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foregroundGravity="center_vertical|center|center_horizontal"
        app:columnCount="2"
        app:columnOrderPreserved="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="w,1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rowCount="4">

        <TextView
            android:id="@+id/textView"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Обьекты"
            app:layout_column="0"
            app:layout_row="1" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Инвентаризация"
            app:layout_column="1"
            app:layout_row="1" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Отчеты"
            app:layout_column="0"
            app:layout_row="3" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Сервис"
            app:layout_column="1"
            app:layout_row="3" />

        <ImageButton
            android:id="@+id/ObjectsButton"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:onClick="clickButtonObjects"
            android:scaleType="centerCrop"
            app:layout_column="0"
            app:layout_row="0"
            app:srcCompat="@drawable/objects"
            tools:ignore="SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/InventoryButton"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:onClick="clickButtonInventory"
            android:scaleType="centerCrop"
            app:layout_column="1"
            app:layout_row="0"
            app:srcCompat="@drawable/inventory" />

        <ImageButton
            android:id="@+id/ReportsButton"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:onClick="clickButtonReports"
            android:scaleType="centerCrop"
            app:layout_column="0"
            app:layout_row="2"
            app:srcCompat="@drawable/reports" />

        <ImageButton
            android:id="@+id/ServiceButton"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:onClick="clickButtonService"
            android:scaleType="centerCrop"
            app:layout_column="1"
            app:layout_row="2"
            app:srcCompat="@drawable/service" />

    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>